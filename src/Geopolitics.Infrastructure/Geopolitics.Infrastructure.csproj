<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The outbound address policy and the provider options validator are internal because nothing
         outside this assembly composes them, but they carry security rules that deserve to be
         asserted directly rather than only through the adapters that use them. -->
    <InternalsVisibleTo Include="Geopolitics.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded demo data is embedded so the replay source works from a published single file. -->
    <EmbeddedResource Include="Sources/Data/replay-observations.json" />

    <!-- The severity model is trained from this corpus at runtime rather than loaded from a
         committed binary, so the dataset has to travel with the assembly. -->
    <EmbeddedResource Include="Ml/Data/severity-dataset.json" />

    <!-- Theatre place names, extracted once from Wikidata by tools/gazetteer/extract.py and
         committed. Embedded rather than read from disk so the lexicon travels with the assembly and
         a published single-file build still has it. The build never fetches this: see
         docs/adr/026-gazetteer-sourcing.md. -->
    <EmbeddedResource Include="Location/Data/theatre-places.json" />

    <!-- The global coarse layer: every first- and second-order administrative unit on earth and the
         settlement that is the seat of each, extracted once from the GeoNames dumps by
         tools/gazetteer/global.py and committed. One line per place rather than JSON because at this
         size the encoding is most of the file: see docs/adr/033-tiered-gazetteer-artefact.md. The
         GeoNames attribution this carries is discharged by NOTICE at the repository root. -->
    <EmbeddedResource Include="Location/Data/global-places.tsv" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Geopolitics.Application\Geopolitics.Application.csproj" />
    <ProjectReference Include="..\Geopolitics.Domain\Geopolitics.Domain.csproj" />
  </ItemGroup>

</Project>
