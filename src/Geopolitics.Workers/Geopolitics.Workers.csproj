<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Geopolitics.Workers-5a62286e-4fe4-45d6-a0ab-6c947d8c6363</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Geopolitics.Application\Geopolitics.Application.csproj" />
    <ProjectReference Include="..\Geopolitics.Infrastructure\Geopolitics.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Collection bundles travel with the build the way the recorded replay stream does, so a
         deployed container carries the cited material it publishes rather than depending on a
         working directory that differs between "dotnet run" and a published image. -->
    <Content Include="..\..\data\osint\*.json">
      <Link>data\osint\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
