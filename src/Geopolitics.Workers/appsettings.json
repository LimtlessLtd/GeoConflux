{
  "ConnectionStrings": {
    "Geopolitics": "Data Source=geopolitics.db"
  },
  "Pipeline": {
    "QueueCapacity": 512,
    "ProcessorConcurrency": 2,
    "CorrelationWindow": "24:00:00",
    "CorrelationRadiusKilometres": 75,
    "SourcesEnabled": true,
    "ProcessorEnabled": true
  },
  "Enrichment": {
    "Enabled": true,
    "Timeout": "00:00:20",
    "MaxRepairAttempts": 1,
    "MinimumAcceptedConfidence": 0.35
  },
  "Ai": {
    "_comment": "Mock is the default so the application runs with no credentials. Set Provider to Ollama, OpenAI, or AzureOpenAI to use a real model. Supply Ai:ApiKey through environment variables, user secrets, or a secret store - never in this file.",
    "Provider": "Mock",
    "Model": "llama3.2",
    "Temperature": 0,
    "Seed": 1,
    "MaxOutputTokens": 800
  },
  "Replay": {
    "Enabled": true,
    "SpeedFactor": 1,
    "Loop": false,
    "LoopPause": "00:02:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
