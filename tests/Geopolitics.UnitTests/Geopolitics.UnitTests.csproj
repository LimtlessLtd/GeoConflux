<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded provider payloads travel with the test assembly so the adapters are exercised
         against the shapes these services actually return, without any network access. -->
    <Content Include="..\data\providers\*">
      <Link>providers\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- Recorded collection bundles. Same purpose as the provider payloads above: the parser is the
         only part that has to understand the contract, so it is pinned to files rather than to
         objects built in a test, and the malformed ones are the point. -->
    <Content Include="..\data\osint\*">
      <Link>osint\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- The bundles this repository actually publishes, linted by the same parser that reads them at
         runtime. This is the offline bundle lint: it needs no separate CI step because "dotnet test"
         already runs everywhere, and one gate that cannot be forgotten beats two that can. -->
    <Content Include="..\..\data\osint\*.json">
      <Link>committed-bundles\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- The workflow files, linted for the rule that makes a self-hosted runner safe on a public
         repository: nothing a stranger can trigger may run on one. Copied rather than located by
         walking up from the test assembly, for the same reason the project files below are. -->
    <Content Include="..\..\.github\workflows\*.yml">
      <Link>workflows\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- The two host project files, linted for what a project has to declare to be run rather than
         merely built. Copied rather than located by walking up from the test assembly, because that
         walk breaks the moment the output path changes and the failure looks like a missing file
         rather than a moved one. -->
    <Content Include="..\..\src\Geopolitics.Api\Geopolitics.Api.csproj;..\..\src\Geopolitics.Workers\Geopolitics.Workers.csproj">
      <Link>host-projects\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Geopolitics.Application\Geopolitics.Application.csproj" />
    <ProjectReference Include="..\..\src\Geopolitics.Infrastructure\Geopolitics.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Geopolitics.Domain\Geopolitics.Domain.csproj" />
  </ItemGroup>

</Project>
